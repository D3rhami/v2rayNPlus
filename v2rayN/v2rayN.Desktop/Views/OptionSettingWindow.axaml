<Window
    x:Class="v2rayN.Desktop.Views.OptionSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSetting}"
    Width="1000"
    Height="780"
    x:DataType="vms:OptionSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.OptionSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.cardTip">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ComboBox.inp">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="TextBox.inp">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>

        <TabControl HorizontalContentAlignment="Stretch">
            <TabItem Header="1. Basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin8}" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Testing &amp; Unblock Engine" />

                                <Grid
                                    Margin="0,0,0,8"
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsMixedConcurrencyCount}"
                                            TextWrapping="Wrap" />
                                        <ComboBox x:Name="cmbMixedConcurrencyCount" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsSpeedTestTimeout}"
                                            TextWrapping="Wrap" />
                                        <ComboBox x:Name="cmbSpeedTestTimeout" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="Unblock batch size"
                                            TextWrapping="Wrap" />
                                        <ComboBox x:Name="cmbUnblockPageSize" Classes="inp" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    Margin="0,0,0,8"
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="10"
                                    RowSpacing="6"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsSpeedTestUrl}" />
                                        <ComboBox
                                            Name="cmbSpeedTestUrl"
                                            Classes="inp"
                                            IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsSpeedPingTestUrl}" />
                                        <ComboBox
                                            x:Name="cmbSpeedPingTestUrl"
                                            Classes="inp"
                                            IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsUdpTestUrl}" />
                                        <ComboBox
                                            x:Name="cmbUdpTestTarget"
                                            Classes="inp"
                                            IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsIPAPIUrl}" />
                                        <ComboBox
                                            x:Name="cmbIPAPIUrl"
                                            Classes="inp"
                                            IsEditable="True" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="8"
                                    RowSpacing="6"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Classes="lbl"
                                        VerticalAlignment="Center"
                                        Text="Run Unblock:" />
                                    <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test YouTube" />
                                            <CheckBox x:Name="chkUnblockYouTube" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test Netflix" />
                                            <CheckBox x:Name="chkUnblockNetflix" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test Gemini" />
                                            <CheckBox x:Name="chkUnblockGemini" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test ChatGPT" />
                                            <CheckBox x:Name="chkUnblockChatGpt" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Classes="lbl"
                                        VerticalAlignment="Center"
                                        Text="Show Column:" />
                                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Show YouTube column" />
                                            <CheckBox x:Name="chkShowColYouTube" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Show Netflix column" />
                                            <CheckBox x:Name="chkShowColNetflix" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Show Gemini column" />
                                            <CheckBox x:Name="chkShowColGemini" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Text="Show ChatGPT column" />
                                            <CheckBox x:Name="chkShowColChatGpt" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Interface, Subscription &amp; Sources" />

                                <Grid
                                    Margin="0,0,0,4"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbRootCertificateProvider}" />
                                        <ComboBox
                                            x:Name="cmbRootCertificateProvider"
                                            Classes="inp"
                                            MaxDropDownHeight="1000" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsMainGirdOrientation}" />
                                        <ComboBox x:Name="cmbMainGirdOrientation" Classes="inp" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    Text="{x:Static resx:ResUI.TbRootCertificateProviderTip}" />

                                <Grid
                                    Margin="0,0,0,6"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsAutoUpdateInterval}" />
                                        <TextBox x:Name="txtautoUpdateInterval" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsTrayMenuServersLimit}" />
                                        <TextBox x:Name="txttrayMenuServersLimit" Classes="inp" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamily}" />
                                <ComboBox
                                    x:Name="cmbcurrentFontFamily"
                                    Classes="inp"
                                    Margin="0,0,0,2"
                                    MaxDropDownHeight="1000"
                                    IsEditable="True" />
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamilyLinuxTip}" />

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    Text="{x:Static resx:ResUI.TbSettingsSubConvert}" />
                                <ComboBox
                                    x:Name="cmbSubConvertUrl"
                                    Classes="inp"
                                    Margin="0,0,0,6"
                                    PlaceholderText="Convert Url"
                                    IsEditable="True" />

                                <Expander
                                    VerticalAlignment="Top"
                                    Header="Custom Geo &amp; Rule Mirrors">
                                    <StackPanel Margin="0,2,0,0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsGeoFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbGetFilesSourceUrl"
                                            Classes="inp"
                                            Margin="0,0,0,2"
                                            IsEditable="True" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Margin="0,0,0,6"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />

                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsSrsFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbSrsFilesSourceUrl"
                                            Classes="inp"
                                            Margin="0,0,0,2"
                                            IsEditable="True" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Margin="0,0,0,6"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />

                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsRoutingRulesSource}" />
                                        <ComboBox
                                            x:Name="cmbRoutingRulesSourceUrl"
                                            Classes="inp"
                                            Margin="0,0,0,2"
                                            IsEditable="True" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2. App behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin8}" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Startup, List &amp; Interactions" />

                                <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        x:Name="tbAutoRun"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsStartBoot}" />
                                    <ToggleSwitch
                                        x:Name="togAutoRun"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsStartBootTip}" />

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsAutoHideStartup}" />
                                    <ToggleSwitch
                                        x:Name="togAutoHideStartup"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsDoubleClick2Activate}" />
                                    <ToggleSwitch
                                        x:Name="togDoubleClick2Activate"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsKeepOlderDedupl}" />
                                    <ToggleSwitch
                                        x:Name="togKeepOlderDedupl"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableAutoAdjustMainLvColWidth}" />
                                    <ToggleSwitch
                                        x:Name="togEnableAutoAdjustMainLvColWidth"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,6"
                                    FontWeight="Bold"
                                    Text="Misc" />

                                <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto" IsVisible="{Binding BlIsLinux}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsHide2TrayWhenClose}" />
                                    <ToggleSwitch
                                        x:Name="togHide2TrayWhenClose"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    IsVisible="{Binding BlIsLinux}"
                                    Text="{x:Static resx:ResUI.TbSettingsHide2TrayWhenCloseTip}" />

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto" IsVisible="{Binding BlIsIsMacOS}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsMacOSShowInDock}" />
                                    <ToggleSwitch
                                        x:Name="togMacOSShowInDock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Monitoring &amp; Rendering" />

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsStatistics}" />
                                    <ToggleSwitch
                                        x:Name="togEnableStatistics"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsDisplayRealTimeSpeed}" />
                                    <ToggleSwitch
                                        x:Name="togDisplayRealTimeSpeed"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableDragDropSort}" />
                                    <ToggleSwitch
                                        x:Name="togEnableDragDropSort"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableHWA}" />
                                    <ToggleSwitch
                                        x:Name="togEnableHWA"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Core: basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin8}" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Local Inbound &amp; Ports" />

                                <Grid
                                    Margin="0,0,0,6"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsSocksPort}" />
                                        <TextBox x:Name="txtlocalPort" Classes="inp" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Margin="0,2,0,0"
                                            Text="{x:Static resx:ResUI.TbSettingsSocksPortTip}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsAetherListenPort}" />
                                        <TextBox x:Name="txtAetherListenPort" Classes="inp" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Margin="0,2,0,0"
                                            Text="{x:Static resx:ResUI.TbSettingsAetherListenPortTip}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsSecondLocalPortEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togSecondLocalPortEnabled"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsUdpEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togudpEnabled"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsSniffingEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togsniffingEnabled"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    Text="{x:Static resx:ResUI.TbSettingsDestOverride}" />
                                <ListBox
                                    x:Name="clbdestOverride"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Multiple,Toggle"
                                    Theme="{DynamicResource CardCheckGroupListBox}" />

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsRouteOnly}" />
                                    <ToggleSwitch
                                        x:Name="togrouteOnly"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsAllowLAN}" />
                                    <ToggleSwitch
                                        x:Name="togAllowLANConn"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsNewPort4LAN}" />
                                    <ToggleSwitch
                                        x:Name="togNewPort4LAN"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsUser}" />
                                        <TextBox x:Name="txtuser" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsPass}" />
                                        <TextBox x:Name="txtpass" Classes="inp" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="TLS, Mux &amp; Logging" />

                                <Grid
                                    Margin="0,0,0,6"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsDefFingerprint}" />
                                        <ComboBox x:Name="cmbdefFingerprint" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsDefUserAgent}" />
                                        <ComboBox x:Name="cmbdefUserAgent" Classes="inp" />
                                        <TextBlock
                                            Classes="cardTip"
                                            Margin="0,2,0,0"
                                            Text="{x:Static resx:ResUI.TbSettingsDefUserAgentTips}" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    Margin="0,0,0,4"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Top">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4SboxProtocol}" />
                                        <ComboBox x:Name="cmbmux4SboxProtocol" Classes="inp" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,2"
                                            Text="{x:Static resx:ResUI.TbSettingsHysteriaBandwidth}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox
                                                x:Name="txtUpMbps"
                                                Width="84"
                                                Classes="inp"
                                                Margin="0,0,4,0"
                                                PlaceholderText="Up" />
                                            <TextBox
                                                x:Name="txtDownMbps"
                                                Width="84"
                                                Classes="inp"
                                                PlaceholderText="Down" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableCacheFile4Sbox}" />
                                    <ToggleSwitch
                                        x:Name="togenableCacheFile4Sbox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsLogEnabledToFile}" />
                                    <ToggleSwitch
                                        x:Name="toglogEnabled"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        Classes="lbl"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsLogLevel}" />
                                    <ComboBox
                                        x:Name="cmbloglevel"
                                        Grid.Column="1"
                                        Width="120"
                                        Classes="inp"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Expander
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Top"
                                    Header="TCP Fragment">
                                    <Grid
                                        Margin="0,2,0,0"
                                        ColumnDefinitions="*,*"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="10"
                                        RowSpacing="6"
                                        VerticalAlignment="Top">
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,0,2"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentPackets}" />
                                            <ComboBox x:Name="cmbFragmentPackets" Classes="inp" />
                                            <TextBlock
                                                Classes="cardTip"
                                                Margin="0,2,0,0"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentPacketsTip}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,0,2"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentLength}" />
                                            <TextBox
                                                x:Name="txtFragmentLengths"
                                                Classes="inp"
                                                PlaceholderText="50-100" />
                                            <TextBlock
                                                Classes="cardTip"
                                                Margin="0,2,0,0"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentLengthTip}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,0,2"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentInterval}" />
                                            <TextBox
                                                x:Name="txtFragmentDelays"
                                                Classes="inp"
                                                PlaceholderText="10-20" />
                                            <TextBlock
                                                Classes="cardTip"
                                                Margin="0,2,0,0"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentIntervalTip}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,0,2"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentMaxSplit}" />
                                            <TextBox
                                                x:Name="txtFragmentMaxSplit"
                                                Classes="inp"
                                                PlaceholderText="0" />
                                            <TextBlock
                                                Classes="cardTip"
                                                Margin="0,2,0,0"
                                                Text="{x:Static resx:ResUI.TbSettingsFragmentMaxSplitTip}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>

                                <Expander
                                    VerticalAlignment="Top"
                                    Header="Xray Mux &amp; XUDP">
                                    <StackPanel Margin="0,2,0,0" VerticalAlignment="Top">
                                        <TextBlock
                                            Classes="lbl"
                                            Margin="0,0,0,4"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4Ray}" />
                                        <Grid
                                            Margin="0,0,0,4"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="10"
                                            VerticalAlignment="Top">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                                <TextBlock
                                                    Classes="lbl"
                                                    Margin="0,0,0,2"
                                                    Text="{x:Static resx:ResUI.TbSettingsMux4RayConcurrency}" />
                                                <TextBox
                                                    x:Name="txtmux4RayConcurrency"
                                                    Classes="inp"
                                                    PlaceholderText="8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock
                                                    Classes="lbl"
                                                    Margin="0,0,0,2"
                                                    Text="{x:Static resx:ResUI.TbSettingsMux4RayXudpConcurrency}" />
                                                <TextBox
                                                    x:Name="txtmux4RayXudpConcurrency"
                                                    Classes="inp"
                                                    PlaceholderText="16" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock
                                                Classes="lbl"
                                                Margin="0,0,0,2"
                                                Text="{x:Static resx:ResUI.TbSettingsMux4RayXudpProxyUDP443}" />
                                            <ComboBox x:Name="cmbmux4RayXudpProxyUDP443" Classes="inp" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,8"
                                    FontWeight="Bold"
                                    Text="Anti-DPI &amp; Binding" />

                                <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableFragment}" />
                                    <ToggleSwitch
                                        x:Name="togenableFragment"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbEnableFinalFragment}" />
                                    <ToggleSwitch
                                        x:Name="togenableFinalFragment"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    Text="{x:Static resx:ResUI.TbEnableFinalFragmentTip}" />

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    Text="{x:Static resx:ResUI.TbSettingsBindInterface}" />
                                <ComboBox
                                    x:Name="cmbbindInterface"
                                    Classes="inp"
                                    Margin="0,0,0,2"
                                    IsEditable="True" />
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,6"
                                    Text="{x:Static resx:ResUI.TbSettingsBindInterfaceTip}" />

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    Text="{x:Static resx:ResUI.TbSettingsSendThrough}" />
                                <TextBox
                                    x:Name="txtsendThrough"
                                    Classes="inp"
                                    Margin="0,0,0,2"
                                    PlaceholderText="0.0.0.0" />
                                <TextBlock
                                    Classes="cardTip"
                                    Text="{x:Static resx:ResUI.TbSettingsSendThroughTip}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Name="tabSystemproxy" Header="4. System proxy settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin8}" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,4"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsExceptionTip}" />
                                <TextBlock
                                    Classes="cardTip"
                                    Margin="0,0,0,4"
                                    IsVisible="{Binding BlIsNonWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsExceptionTip2}" />
                                <TextBox
                                    x:Name="txtsystemProxyExceptions"
                                    MinHeight="160"
                                    BorderThickness="1"
                                    Classes="TextArea"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Padding="12"
                            VerticalAlignment="Top"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel VerticalAlignment="Top">
                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto" IsVisible="{Binding BlIsWindows}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Static resx:ResUI.TbSettingsNotProxyLocalAddress}" />
                                    <ToggleSwitch
                                        x:Name="tognotProxyLocalAddress"
                                        Grid.Column="1"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsAdvancedProtocol}" />
                                <ComboBox
                                    x:Name="cmbsystemProxyAdvancedProtocol"
                                    Classes="inp"
                                    Margin="0,0,0,6"
                                    IsVisible="{Binding BlIsWindows}"
                                    PlaceholderText="Protocol" />

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsCustomSystemProxyPacPath}" />
                                <Grid
                                    Margin="0,0,0,6"
                                    ColumnDefinitions="*,Auto"
                                    IsVisible="{Binding BlIsWindows}">
                                    <TextBox
                                        x:Name="txtCustomSystemProxyPacPath"
                                        Grid.Column="0"
                                        Classes="inp"
                                        VerticalAlignment="Center"
                                        PlaceholderText="pac.txt"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="btnBrowseCustomSystemProxyPacPath"
                                        Grid.Column="1"
                                        Height="30"
                                        MinHeight="30"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{x:Static resx:ResUI.TbBrowse}" />
                                </Grid>

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,6"
                                    FontWeight="Bold"
                                    Text="Misc" />

                                <TextBlock
                                    Classes="lbl"
                                    Margin="0,0,0,2"
                                    IsVisible="{Binding BlIsNonWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsCustomSystemProxyScriptPath}" />
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    IsVisible="{Binding BlIsNonWindows}">
                                    <TextBox
                                        x:Name="txtCustomSystemProxyScriptPath"
                                        Grid.Column="0"
                                        Classes="inp"
                                        VerticalAlignment="Center"
                                        PlaceholderText="proxy_set.sh"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="btnBrowseCustomSystemProxyScriptPath"
                                        Grid.Column="1"
                                        Height="30"
                                        MinHeight="30"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{x:Static resx:ResUI.TbBrowse}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbSettingsTunMode}">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid
                        Margin="{StaticResource Margin4}"
                        ColumnDefinitions="Auto,Auto,Auto"
                        DockPanel.Dock="Top"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunAutoRoute}" />
                        <ToggleSwitch
                            x:Name="togAutoRoute"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunStrictRoute}" />
                        <ToggleSwitch
                            x:Name="togStrictRoute"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunStack}" />
                        <ComboBox
                            x:Name="cmbStack"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbMtu}" />
                        <ComboBox
                            x:Name="cmbMtu"
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIcmpRoutingPolicy}" />
                        <ComboBox
                            x:Name="cmbIcmpRoutingPolicy"
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsEnableIPv6Address}" />
                        <ToggleSwitch
                            x:Name="togEnableIPv6Address"
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbLegacyProtect}" />
                        <ToggleSwitch
                            x:Name="togEnableLegacyProtect"
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbLegacyProtectTip}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbRouteExcludeAddress}" />
                        <TextBox
                            x:Name="txtRouteExcludeAddress"
                            Grid.Row="9"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            Classes="TextArea"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbRouteExcludeAddressTip}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIpv4Address}" />
                        <ComboBox
                            x:Name="cmbIpv4Address"
                            Grid.Row="10"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="11"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIpv6Address}" />
                        <ComboBox
                            x:Name="cmbIpv6Address"
                            Grid.Row="11"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="12"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunDnsMode}" />
                        <ComboBox
                            x:Name="cmbDnsMode"
                            Grid.Row="12"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbSettingsCoreType}">
                <Grid
                    Margin="{StaticResource Margin4}"
                    ColumnDefinitions="Auto,Auto"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="VMess" />
                    <ComboBox
                        x:Name="cmbCoreType1"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Custom Pre" />
                    <ComboBox
                        x:Name="cmbCoreType2"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Shadowsocks" />
                    <ComboBox
                        x:Name="cmbCoreType3"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Socks" />
                    <ComboBox
                        x:Name="cmbCoreType4"
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="VLESS" />
                    <ComboBox
                        x:Name="cmbCoreType5"
                        Grid.Row="5"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Trojan" />
                    <ComboBox
                        x:Name="cmbCoreType6"
                        Grid.Row="6"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Hysteria2" />
                    <ComboBox
                        x:Name="cmbCoreType7"
                        Grid.Row="7"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Wireguard" />
                    <ComboBox
                        x:Name="cmbCoreType9"
                        Grid.Row="8"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="MASQUE" />
                    <ComboBox
                        x:Name="cmbCoreType14"
                        Grid.Row="9"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
