<Window
    x:Class="v2rayN.Desktop.Views.OptionSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSetting}"
    Width="1000"
    Height="700"
    x:DataType="vms:OptionSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.OptionSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>

        <TabControl HorizontalContentAlignment="Stretch">
            <TabItem Header="1. Basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Testing &amp; Unblock Engine" />

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsMixedConcurrencyCount}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbMixedConcurrencyCount"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedTestTimeout}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbSpeedTestTimeout"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="{StaticResource Margin4}"
                                        Text="Unblock batch size"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbUnblockPageSize"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="{StaticResource Margin4}" />
                                </Grid>

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedTestUrl}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedPingTestUrl}" />
                                    <ComboBox
                                        Name="cmbSpeedTestUrl"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True" />
                                    <ComboBox
                                        x:Name="cmbSpeedPingTestUrl"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsUdpTestUrl}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Text="{x:Static resx:ResUI.TbSettingsIPAPIUrl}" />
                                    <ComboBox
                                        x:Name="cmbUdpTestTarget"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True" />
                                    <ComboBox
                                        x:Name="cmbIPAPIUrl"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True" />
                                </Grid>

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Text="Run Unblock:" />
                                    <WrapPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}">
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test YouTube" />
                                            <CheckBox
                                                x:Name="chkUnblockYouTube"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test Netflix" />
                                            <CheckBox
                                                x:Name="chkUnblockNetflix"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test Gemini" />
                                            <CheckBox
                                                x:Name="chkUnblockGemini"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Unblock: test ChatGPT" />
                                            <CheckBox
                                                x:Name="chkUnblockChatGpt"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Text="Show Column:" />
                                    <WrapPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}">
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Show YouTube column" />
                                            <CheckBox
                                                x:Name="chkShowColYouTube"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Show Netflix column" />
                                            <CheckBox
                                                x:Name="chkShowColNetflix"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Show Gemini column" />
                                            <CheckBox
                                                x:Name="chkShowColGemini"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="{StaticResource Margin4}"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Text="Show ChatGPT column" />
                                            <CheckBox
                                                x:Name="chkShowColChatGpt"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Interface, Subscription &amp; Sources" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbRootCertificateProvider}" />
                                <ComboBox
                                    x:Name="cmbRootCertificateProvider"
                                    Margin="{StaticResource Margin4}"
                                    MaxDropDownHeight="1000" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbRootCertificateProviderTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsMainGirdOrientation}" />
                                <ComboBox
                                    x:Name="cmbMainGirdOrientation"
                                    Margin="{StaticResource Margin4}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsAutoUpdateInterval}" />
                                <TextBox
                                    x:Name="txtautoUpdateInterval"
                                    Margin="{StaticResource Margin4}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsTrayMenuServersLimit}" />
                                <TextBox
                                    x:Name="txttrayMenuServersLimit"
                                    Margin="{StaticResource Margin4}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamily}" />
                                <ComboBox
                                    x:Name="cmbcurrentFontFamily"
                                    Margin="{StaticResource Margin4}"
                                    MaxDropDownHeight="1000"
                                    IsEditable="True" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamilyLinuxTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsSubConvert}" />
                                <ComboBox
                                    x:Name="cmbSubConvertUrl"
                                    Margin="{StaticResource Margin4}"
                                    PlaceholderText="Convert Url"
                                    IsEditable="True" />

                                <Expander
                                    Margin="{StaticResource Margin4}"
                                    Header="Custom Geo &amp; Rule Mirrors">
                                    <StackPanel Margin="{StaticResource Margin4}">
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsGeoFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbGetFilesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsSrsFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbSrsFilesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsRoutingRulesSource}" />
                                        <ComboBox
                                            x:Name="cmbRoutingRulesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2. App behavior">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Startup, List &amp; Interactions" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="tbAutoRun"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsStartBoot}" />
                                    <ToggleSwitch
                                        x:Name="togAutoRun"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsStartBootTip}"
                                    TextWrapping="Wrap" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsAutoHideStartup}" />
                                    <ToggleSwitch
                                        x:Name="togAutoHideStartup"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsDoubleClick2Activate}" />
                                    <ToggleSwitch
                                        x:Name="togDoubleClick2Activate"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsKeepOlderDedupl}" />
                                    <ToggleSwitch
                                        x:Name="togKeepOlderDedupl"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableAutoAdjustMainLvColWidth}" />
                                    <ToggleSwitch
                                        x:Name="togEnableAutoAdjustMainLvColWidth"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource MarginTb8}"
                                    FontWeight="Bold"
                                    Text="Misc" />

                                <StackPanel
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsLinux}"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsHide2TrayWhenClose}" />
                                    <ToggleSwitch
                                        x:Name="togHide2TrayWhenClose"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsLinux}"
                                    Text="{x:Static resx:ResUI.TbSettingsHide2TrayWhenCloseTip}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsIsMacOS}"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsMacOSShowInDock}" />
                                    <ToggleSwitch
                                        x:Name="togMacOSShowInDock"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Monitoring &amp; Rendering" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsStatistics}" />
                                    <ToggleSwitch
                                        x:Name="togEnableStatistics"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsDisplayRealTimeSpeed}" />
                                    <ToggleSwitch
                                        x:Name="togDisplayRealTimeSpeed"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableDragDropSort}" />
                                    <ToggleSwitch
                                        x:Name="togEnableDragDropSort"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableHWA}" />
                                    <ToggleSwitch
                                        x:Name="togEnableHWA"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Core: basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Local Inbound &amp; Ports" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsSocksPort}" />
                                <TextBox
                                    x:Name="txtlocalPort"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsSocksPortTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsAetherListenPort}" />
                                <TextBox
                                    x:Name="txtAetherListenPort"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsAetherListenPortTip}"
                                    TextWrapping="Wrap" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsSecondLocalPortEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togSecondLocalPortEnabled"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsUdpEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togudpEnabled"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsSniffingEnabled}" />
                                    <ToggleSwitch
                                        x:Name="togsniffingEnabled"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsDestOverride}" />
                                <ListBox
                                    x:Name="clbdestOverride"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Multiple,Toggle"
                                    Theme="{DynamicResource CardCheckGroupListBox}" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsRouteOnly}" />
                                    <ToggleSwitch
                                        x:Name="togrouteOnly"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsAllowLAN}" />
                                    <ToggleSwitch
                                        x:Name="togAllowLANConn"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsNewPort4LAN}" />
                                    <ToggleSwitch
                                        x:Name="togNewPort4LAN"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsUser}" />
                                <TextBox
                                    x:Name="txtuser"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsPass}" />
                                <TextBox
                                    x:Name="txtpass"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="TLS, Mux &amp; Logging" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsDefFingerprint}" />
                                <ComboBox
                                    x:Name="cmbdefFingerprint"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsDefUserAgent}" />
                                <ComboBox
                                    x:Name="cmbdefUserAgent"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsDefUserAgentTips}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsMux4SboxProtocol}" />
                                <ComboBox
                                    x:Name="cmbmux4SboxProtocol"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsHysteriaBandwidth}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        x:Name="txtUpMbps"
                                        Width="90"
                                        Margin="{StaticResource Margin8}"
                                        PlaceholderText="Up" />
                                    <TextBox
                                        x:Name="txtDownMbps"
                                        Width="90"
                                        Margin="{StaticResource Margin8}"
                                        PlaceholderText="Down" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableCacheFile4Sbox}" />
                                    <ToggleSwitch
                                        x:Name="togenableCacheFile4Sbox"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsLogEnabledToFile}" />
                                    <ToggleSwitch
                                        x:Name="toglogEnabled"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsLogLevel}" />
                                <ComboBox
                                    x:Name="cmbloglevel"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left" />

                                <Expander
                                    Margin="{StaticResource Margin4}"
                                    Header="TCP Fragment">
                                    <StackPanel Margin="{StaticResource Margin4}">
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentPackets}"
                                            TextWrapping="Wrap" />
                                        <ComboBox
                                            x:Name="cmbFragmentPackets"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentPacketsTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentLength}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="txtFragmentLengths"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            PlaceholderText="50-100" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentLengthTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentInterval}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="txtFragmentDelays"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            PlaceholderText="10-20" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentIntervalTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentMaxSplit}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="txtFragmentMaxSplit"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            PlaceholderText="0" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsFragmentMaxSplitTip}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>

                                <Expander
                                    Margin="{StaticResource Margin4}"
                                    Header="Xray Mux &amp; XUDP">
                                    <StackPanel Margin="{StaticResource Margin4}">
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4Ray}" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4RayConcurrency}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="txtmux4RayConcurrency"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="8" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4RayXudpConcurrency}"
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="txtmux4RayXudpConcurrency"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="16" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Text="{x:Static resx:ResUI.TbSettingsMux4RayXudpProxyUDP443}"
                                            TextWrapping="Wrap" />
                                        <ComboBox
                                            x:Name="cmbmux4RayXudpProxyUDP443"
                                            Width="200"
                                            Margin="{StaticResource Margin4}"
                                            HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Text="Anti-DPI &amp; Binding" />

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableFragment}" />
                                    <ToggleSwitch
                                        x:Name="togenableFragment"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbEnableFinalFragment}" />
                                    <ToggleSwitch
                                        x:Name="togenableFinalFragment"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    Text="{x:Static resx:ResUI.TbEnableFinalFragmentTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsBindInterface}" />
                                <ComboBox
                                    x:Name="cmbbindInterface"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    IsEditable="True" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsBindInterfaceTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsSendThrough}" />
                                <TextBox
                                    x:Name="txtsendThrough"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    PlaceholderText="0.0.0.0" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Text="{x:Static resx:ResUI.TbSettingsSendThroughTip}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Name="tabSystemproxy" Header="4. System proxy settings">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsExceptionTip}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsNonWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsExceptionTip2}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="txtsystemProxyExceptions"
                                    MinHeight="160"
                                    Margin="{StaticResource Margin4}"
                                    BorderThickness="1"
                                    Classes="TextArea"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            Theme="{DynamicResource CardBorder}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <StackPanel
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsWindows}"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbSettingsNotProxyLocalAddress}" />
                                    <ToggleSwitch
                                        x:Name="tognotProxyLocalAddress"
                                        Margin="{StaticResource Margin8}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsAdvancedProtocol}" />
                                <ComboBox
                                    x:Name="cmbsystemProxyAdvancedProtocol"
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsWindows}"
                                    PlaceholderText="Protocol" />

                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsCustomSystemProxyPacPath}" />
                                <Grid
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsWindows}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="txtCustomSystemProxyPacPath"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        PlaceholderText="pac.txt"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="btnBrowseCustomSystemProxyPacPath"
                                        Grid.Column="1"
                                        Margin="{StaticResource MarginLr4}"
                                        VerticalAlignment="Center"
                                        Content="{x:Static resx:ResUI.TbBrowse}" />
                                </Grid>

                                <TextBlock
                                    Margin="{StaticResource MarginTb8}"
                                    FontWeight="Bold"
                                    Text="Misc" />

                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    IsVisible="{Binding BlIsNonWindows}"
                                    Text="{x:Static resx:ResUI.TbSettingsCustomSystemProxyScriptPath}" />
                                <Grid
                                    Margin="{StaticResource Margin4}"
                                    IsVisible="{Binding BlIsNonWindows}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="txtCustomSystemProxyScriptPath"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        PlaceholderText="proxy_set.sh"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="btnBrowseCustomSystemProxyScriptPath"
                                        Grid.Column="1"
                                        Margin="{StaticResource MarginLr4}"
                                        VerticalAlignment="Center"
                                        Content="{x:Static resx:ResUI.TbBrowse}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbSettingsTunMode}">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid
                        Margin="{StaticResource Margin4}"
                        ColumnDefinitions="Auto,Auto,Auto"
                        DockPanel.Dock="Top"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunAutoRoute}" />
                        <ToggleSwitch
                            x:Name="togAutoRoute"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunStrictRoute}" />
                        <ToggleSwitch
                            x:Name="togStrictRoute"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunStack}" />
                        <ComboBox
                            x:Name="cmbStack"
                            Grid.Row="4"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbMtu}" />
                        <ComboBox
                            x:Name="cmbMtu"
                            Grid.Row="5"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIcmpRoutingPolicy}" />
                        <ComboBox
                            x:Name="cmbIcmpRoutingPolicy"
                            Grid.Row="6"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsEnableIPv6Address}" />
                        <ToggleSwitch
                            x:Name="togEnableIPv6Address"
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbLegacyProtect}" />
                        <ToggleSwitch
                            x:Name="togEnableLegacyProtect"
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbLegacyProtectTip}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbRouteExcludeAddress}" />
                        <TextBox
                            x:Name="txtRouteExcludeAddress"
                            Grid.Row="9"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            Classes="TextArea"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="2"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbRouteExcludeAddressTip}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIpv4Address}" />
                        <ComboBox
                            x:Name="cmbIpv4Address"
                            Grid.Row="10"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="11"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbIpv6Address}" />
                        <ComboBox
                            x:Name="cmbIpv6Address"
                            Grid.Row="11"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />

                        <TextBlock
                            Grid.Row="12"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbSettingsTunDnsMode}" />
                        <ComboBox
                            x:Name="cmbDnsMode"
                            Grid.Row="12"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbSettingsCoreType}">
                <Grid
                    Margin="{StaticResource Margin4}"
                    ColumnDefinitions="Auto,Auto"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="VMess" />
                    <ComboBox
                        x:Name="cmbCoreType1"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Custom Pre" />
                    <ComboBox
                        x:Name="cmbCoreType2"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Shadowsocks" />
                    <ComboBox
                        x:Name="cmbCoreType3"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Socks" />
                    <ComboBox
                        x:Name="cmbCoreType4"
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="VLESS" />
                    <ComboBox
                        x:Name="cmbCoreType5"
                        Grid.Row="5"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Trojan" />
                    <ComboBox
                        x:Name="cmbCoreType6"
                        Grid.Row="6"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Hysteria2" />
                    <ComboBox
                        x:Name="cmbCoreType7"
                        Grid.Row="7"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="Wireguard" />
                    <ComboBox
                        x:Name="cmbCoreType9"
                        Grid.Row="8"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="MASQUE" />
                    <ComboBox
                        x:Name="cmbCoreType14"
                        Grid.Row="9"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
