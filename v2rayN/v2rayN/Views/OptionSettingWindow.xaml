<base:WindowBase
    x:Class="v2rayN.Views.OptionSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSetting}"
    Width="1000"
    Height="700"
    x:TypeArguments="vms:OptionSettingViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <TabControl HorizontalContentAlignment="Left">
            <TabItem Header="1. Basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="Testing &amp; Unblock Engine" />

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsMixedConcurrencyCount}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbMixedConcurrencyCount"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource DefComboBox}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedTestTimeout}"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbSpeedTestTimeout"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource DefComboBox}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="Unblock batch size"
                                        TextWrapping="Wrap" />
                                    <ComboBox
                                        x:Name="cmbUnblockPageSize"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource DefComboBox}" />
                                </Grid>

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedTestUrl}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsSpeedPingTestUrl}" />
                                    <ComboBox
                                        x:Name="cmbSpeedTestUrl"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True"
                                        Style="{StaticResource DefComboBox}" />
                                    <ComboBox
                                        x:Name="cmbSpeedPingTestUrl"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True"
                                        Style="{StaticResource DefComboBox}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsUdpTestUrl}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsIPAPIUrl}" />
                                    <ComboBox
                                        x:Name="cmbUdpTestTarget"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True"
                                        Style="{StaticResource DefComboBox}" />
                                    <ComboBox
                                        x:Name="cmbIPAPIUrl"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}"
                                        IsEditable="True"
                                        Style="{StaticResource DefComboBox}" />
                                </Grid>

                                <Grid Margin="{StaticResource Margin4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="Run Unblock:" />
                                    <WrapPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}">
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Unblock: test YouTube" />
                                            <CheckBox
                                                x:Name="chkUnblockYouTube"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Unblock: test Netflix" />
                                            <CheckBox
                                                x:Name="chkUnblockNetflix"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Unblock: test Gemini" />
                                            <CheckBox
                                                x:Name="chkUnblockGemini"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Unblock: test ChatGPT" />
                                            <CheckBox
                                                x:Name="chkUnblockChatGpt"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="Show Column:" />
                                    <WrapPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{StaticResource Margin4}">
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Show YouTube column" />
                                            <CheckBox
                                                x:Name="chkShowColYouTube"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Show Netflix column" />
                                            <CheckBox
                                                x:Name="chkShowColNetflix"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Show Gemini column" />
                                            <CheckBox
                                                x:Name="chkShowColGemini"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                            <TextBlock
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ToolbarTextBlock}"
                                                Text="Show ChatGPT column" />
                                            <CheckBox
                                                x:Name="chkShowColChatGpt"
                                                Margin="{StaticResource Margin4}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="Interface, Subscription &amp; Sources" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRootCertificateProvider}" />
                                <ComboBox
                                    x:Name="cmbRootCertificateProvider"
                                    Margin="{StaticResource Margin4}"
                                    MaxDropDownHeight="1000"
                                    Style="{StaticResource DefComboBox}" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRootCertificateProviderTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsMainGirdOrientation}" />
                                <ComboBox
                                    x:Name="cmbMainGirdOrientation"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefComboBox}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsAutoUpdateInterval}" />
                                <TextBox
                                    x:Name="txtautoUpdateInterval"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsTrayMenuServersLimit}" />
                                <TextBox
                                    x:Name="txttrayMenuServersLimit"
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource DefTextBox}" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamily}" />
                                <ComboBox
                                    x:Name="cmbcurrentFontFamily"
                                    Margin="{StaticResource Margin4}"
                                    MaxDropDownHeight="1000"
                                    Style="{StaticResource DefComboBox}" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamilyTip}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsSubConvert}" />
                                <ComboBox
                                    x:Name="cmbSubConvertUrl"
                                    Margin="{StaticResource Margin4}"
                                    materialDesign:HintAssist.Hint="Convert Url"
                                    IsEditable="True"
                                    Style="{StaticResource DefComboBox}" />

                                <Expander
                                    Margin="{StaticResource Margin4}"
                                    Header="Custom Geo &amp; Rule Mirrors">
                                    <StackPanel Margin="{StaticResource Margin4}">
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsGeoFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbGetFilesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True"
                                            Style="{StaticResource DefComboBox}" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsSrsFilesSource}" />
                                        <ComboBox
                                            x:Name="cmbSrsFilesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True"
                                            Style="{StaticResource DefComboBox}" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsRoutingRulesSource}" />
                                        <ComboBox
                                            x:Name="cmbRoutingRulesSourceUrl"
                                            Margin="{StaticResource Margin4}"
                                            IsEditable="True"
                                            Style="{StaticResource DefComboBox}" />
                                        <TextBlock
                                            Margin="{StaticResource Margin4}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2. App behavior">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="Startup, List &amp; Interactions" />

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsStartBoot}" />
                                    <ToggleButton
                                        x:Name="togAutoRun"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsStartBootTip}"
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsAutoHideStartup}" />
                                    <ToggleButton
                                        x:Name="togAutoHideStartup"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsDoubleClick2Activate}" />
                                    <ToggleButton
                                        x:Name="togDoubleClick2Activate"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsKeepOlderDedupl}" />
                                    <ToggleButton
                                        x:Name="togKeepOlderDedupl"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableAutoAdjustMainLvColWidth}" />
                                    <ToggleButton
                                        x:Name="togEnableAutoAdjustMainLvColWidth"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card
                            Grid.Column="1"
                            Margin="{StaticResource Margin4}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="Monitoring &amp; Rendering" />

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsStatistics}" />
                                    <ToggleButton
                                        x:Name="togEnableStatistics"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsDisplayRealTimeSpeed}" />
                                    <ToggleButton
                                        x:Name="togDisplayRealTimeSpeed"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableDragDropSort}" />
                                    <ToggleButton
                                        x:Name="togEnableDragDropSort"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableHWA}" />
                                    <ToggleButton
                                        x:Name="togEnableHWA"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3. Core: basic settings">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <Grid Margin="{StaticResource Margin8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="Local Inbound &amp; Ports" />

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsSocksPort}" />
                                <TextBox
                                    x:Name="txtlocalPort"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DefTextBox}" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsSocksPortTip}"
                                    TextWrapping="Wrap" />

                                <!--  PattN: the port every Aether core listens on, under the mixed port, whatever the local proxy settings are  -->
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsAetherListenPort}" />
                                <TextBox
                                    x:Name="txtAetherListenPort"
                                    Width="200"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DefTextBox}" />
                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsAetherListenPortTip}"
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsSecondLocalPortEnabled}" />
                                    <ToggleButton
                                        x:Name="togSecondLocalPortEnabled"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsUdpEnabled}" />
                                    <ToggleButton
                                        x:Name="togudpEnabled"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
                                    <TextBlock
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsSniffingEnabled}" />
                                    <ToggleButton
                                        x:Name="togsniffingEnabled"
                                        Margin="{StaticResource Margin8}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock
                                    Margin="{StaticResource Margin4}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbSettingsDestOverride}" />
                                <ListBox
                                    x:Name="clbdestOverride"
                                    Margin="{StaticResource Margin4}"
                                    HorizontalAlignment="Left"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilterChipPrimaryListBox}" />

                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin4}">
